[27.921, "o", "  \u001b[38;5;245mBlocked 3 bad packages and let 1 real one through.\u001b[39m\r\n"]
[27.9211, "o", "  \u001b[38;5;245m\u00b7 Claude Code: installs are checked before they run. BLOCK denies the command, WARN asks you.\u001b[39m\r\n  \u001b[38;5;245m\u00b7 Cursor: restart it (or reload MCP servers) to pick up pkgsentry.\u001b[39m\r\n"]
[27.9211, "o", "  \u001b[38;5;245m\u00b7 Codex CLI: start a new session to pick up pkgsentry.\u001b[39m\r\n  \u001b[38;5;245mGuard any one-off install:\u001b[39m \u001b[38;5;80mnpx pkgsentry run -- npm install <pkg>\u001b[39m\r\n  \u001b[38;5;245mUndo any time:\u001b[39m \u001b[38;5;80mnpx pkgsentry uninstall\u001b[39m\r\n\r\n"]
[27.9217, "o", "\u001b[?25h"]
