# Alternative demo recording with charmbracelet/vhs:  vhs scripts/demo/demo.tape
# (docs/demo.gif is generated by make-gif.py, which needs only Python + Pillow.)
Output docs/demo-vhs.gif
Set FontSize 16
Set Width 1100
Set Height 620
Set Theme "Dracula"
Set TypingSpeed 45ms

Type "npx pkgsentry check pypi reqeusts" Sleep 300ms Enter Sleep 4s
Type "npx pkgsentry check npm lodahs expresss express" Sleep 300ms Enter Sleep 5s
Type "npx pkgsentry run -- pip install fastapi pyvaisala" Sleep 300ms Enter Sleep 5s
Type "npx pkgsentry setup --dry-run" Sleep 300ms Enter Sleep 6s
